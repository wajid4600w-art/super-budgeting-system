# Server
PORT=3000

# AI providers (optional — leave blank to disable server-side AI)
GEMINI_API_KEY=your_gemini_key
OPENROUTER_API_KEY=your_openrouter_key

# Supabase (optional — enables cloud DB for users, finance & feedback + /admin)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Token required to open /admin (also stored in the admin_config table)
ADMIN_TOKEN=change_me_admin_token