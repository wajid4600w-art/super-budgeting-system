# Optional: local Node server (server.js) — NOT needed for GitHub Pages.
# The static site uses Firebase (see firebase-config.js + FIREBASE_SETUP.md).
PORT=3000

# AI providers (optional — server-side AI; on static hosting AI uses in-browser Gemini)
GEMINI_API_KEY=your_gemini_key
OPENROUTER_API_KEY=your_openrouter_key